{
  "name": "law-caddy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npx wrangler pages dev dist --port 8788",
    "build": "tsc -b && vite build",
    "preview": "npx wrangler pages dev dist",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name law-caddy && bash scripts/post-deploy-check.sh",
    "deploy:only": "npx wrangler pages deploy dist --project-name law-caddy && bash scripts/post-deploy-check.sh",
    "lint": "eslint .",
    "test": "vitest",
    "test:ci": "vitest run",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "dependencies": {
    "@sentry/react": "^10.42.0",
    "@supabase/supabase-js": "^2.98.0",
    "docx": "^9.6.0",
    "easycodef-node": "^1.0.4",
    "file-saver": "^2.0.5",
    "firebase": "^12.9.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "node-forge": "^1.3.3",
    "pdfjs-dist": "^5.4.624",
    "pg": "^8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^7.13.1",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260305.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.10.1",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.3.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.68.1"
  }
}
