rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 녹음 파일: 본인만 읽기/쓰기
    match /recordings/{ownerId}/{caseId}/{fileName} {
      allow read, write: if request.auth != null
        && request.auth.uid == ownerId;
    }

    // 상대방 서면 파일: 본인만 읽기/쓰기
    match /opponent-docs/{ownerId}/{caseId}/{fileName} {
      allow read, write: if request.auth != null
        && request.auth.uid == ownerId;
    }

    // 문서 내보내기 파일: 본인만 읽기/쓰기
    match /documents/{ownerId}/{caseId}/{fileName} {
      allow read, write: if request.auth != null
        && request.auth.uid == ownerId;
    }
  }
}
