# Firebase (프론트엔드 빌드 시 번들링)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase (RAG 벡터 검색)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Voyage AI (임베딩 — 로컬 개발 전용)
VITE_VOYAGE_API_KEY=

# Sentry (에러 모니터링)
VITE_SENTRY_DSN=

# CODEF 자동수집 탭 노출 여부 — 변호사법 §26 재위탁 이슈로 법무 검토 후 활성화
# 기본값(미설정 또는 false): FinancePage에서 CODEF 탭 숨김. CodefSyncTab.tsx 사용 안 됨.
# 활성화 전 모듈 B(CodefSyncTab → 오케스트레이터 연결) 수정 필요 — 현재 AI 매칭 우회 버그 있음
# VITE_ENABLE_CODEF=false

# Toss Payments 결제위젯 클라이언트 키 (결제위젯 연동 키, live_gck_ 또는 test_gck_)
# VITE_TOSS_CLIENT_KEY=

# --- 로컬 개발 전용 (선택) ---
# 직접 브라우저 호출 (VITE_ANTHROPIC_API_KEY 없으면 /api/claude 프록시 사용)
# VITE_ANTHROPIC_API_KEY=

# --- 서버사이드 시크릿 (Cloudflare 대시보드 또는 .dev.vars에 설정) ---
# ANTHROPIC_API_KEY=
# RTZR_CLIENT_ID=
# RTZR_CLIENT_SECRET=
# FIREBASE_PROJECT_ID=

# --- CODEF (정식버전) — functions/api/codef/* 프록시에서 사용 ---
# CODEF_CLIENT_ID=
# CODEF_CLIENT_SECRET=
# CODEF_PUBLIC_KEY=   # PEM 헤더/푸터·공백 제거한 base64 본문만 한 줄

# --- Firebase Admin SDK (서비스 계정) — /api/ical/* 에서 Firestore REST 호출용 ---
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=   # JSON 원본 이스케이프(\n) 그대로 쌍따옴표로 감싸서 저장

# --- Toss Payments (결제위젯 연동 키의 secret) — /api/payment/confirm 에서 사용 ---
# TOSS_SECRET_KEY=

# --- SOLAPI (가입 알림 SMS) — /api/notify/signup 에서 사용 ---
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER_NUMBER=   # SOLAPI에 사전 등록된 발신번호
# ADMIN_NOTIFY_PHONE=     # 가입 알림을 받을 관리자 번호
