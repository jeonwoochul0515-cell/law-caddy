rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ──

    // 로그인 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 관리자 역할 확인
    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // 본인 문서 확인 (ownerId 필드 기준)
    function isOwner() {
      return isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
    }

    // 생성 시 본인 ownerId 필드 확인
    function isOwnerOnCreate() {
      return isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
    }

    // ── 사용자 프로필 ──
    match /users/{uid} {
      // 본인 문서 읽기
      allow read: if isAuthenticated() && request.auth.uid == uid;

      // 본인 문서 생성 (가입 시: role은 lawyer 고정, status는 pending/approved만)
      allow create: if isAuthenticated() && request.auth.uid == uid
        && request.resource.data.role == "lawyer"
        && request.resource.data.status in ["pending", "approved"];

      // 본인 문서 수정 (role 변경 금지, status는 프로필 완성 시 pending→approved만 허용)
      allow update: if isAuthenticated() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == "pending" && request.resource.data.status == "approved"
              && request.resource.data.profileCompleted == true)
        )
        && (!("verified" in request.resource.data) || request.resource.data.verified == resource.data.verified);

      // 관리자: 모든 사용자 문서 읽기/쓰기 (역할/상태 값 검증 포함)
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.role in ["lawyer", "admin"]
        && request.resource.data.status in ["pending", "approved", "rejected"];
    }

    // ── 사건 ──
    match /cases/{caseId} {
      // 생성 시 ownerId 검증 + status 유효값 검증
      allow create: if isOwnerOnCreate()
        && request.resource.data.status in ["진행중", "완료", "보류"];

      // 본인 문서 읽기
      allow read: if isOwner();

      // 수정 시 status 유효값 검증
      allow update: if isOwner()
        && request.resource.data.status in ["진행중", "완료", "보류"];

      // 삭제는 본인만
      allow delete: if isOwner();

      // 관리자: 읽기 허용
      allow read: if isAdmin();

      // ── 의뢰인 케어 메시지 (서브컬렉션) ──
      match /clientCareMessages/{messageId} {
        // 사건 소유자만 읽기/쓰기
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;

        // 관리자: 읽기 허용
        allow read: if isAdmin();
      }
    }

    // ── 녹음 ──
    match /recordings/{recordingId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();

      // 관리자: 읽기 허용
      allow read: if isAdmin();
    }

    // ── 법률 문서 ──
    match /documents/{documentId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();

      // 관리자: 읽기 허용
      allow read: if isAdmin();
    }

    // ── 상대방 서면 ──
    match /opponentDocs/{docId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();

      // 관리자: 읽기 허용
      allow read: if isAdmin();
    }

    // ── 사건기록 (전자소송 PDF + 자동 분류 + AI 분석 결과 임베드) ──
    match /case_records/{recordId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();

      // 관리자: 읽기 허용
      allow read: if isAdmin();
    }

    // ── 사건 기한 (일정 탭) ──
    match /deadlines/{deadlineId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();

      // 관리자: 읽기 허용
      allow read: if isAdmin();
    }

    // ── 수임료 (Fees) ──
    match /fees/{feeId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();
      allow read: if isAdmin();

      // ── 분할납부 (Installments 서브컬렉션) ──
      match /installments/{installmentId} {
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/fees/$(feeId)).data.ownerId == request.auth.uid;
        allow read, update, delete: if isAuthenticated()
          && get(/databases/$(database)/documents/fees/$(feeId)).data.ownerId == request.auth.uid;
        allow read: if isAdmin();
      }
    }

    // ── 사건별 경비 (Case Expenses) ──
    match /case_expenses/{expenseId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();
      allow read: if isAdmin();
    }

    // ── 거래 내역 (Transactions) ──
    match /transactions/{transactionId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();
      allow read: if isAdmin();
    }

    // ── 사무소 경비 (Office Expenses) ──
    match /office_expenses/{expenseId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();
      allow read: if isAdmin();
    }

    // ── 예수금 (Deposits) ──
    match /deposits/{depositId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();
      allow read: if isAdmin();
    }

    // ── 구독 정보 ──
    // 사용자는 본인 구독만 읽기 가능, 쓰기는 서버(Admin SDK) 또는 관리자만
    match /subscriptions/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow read: if isAdmin();

      // 클라이언트 쓰기 차단 — Admin SDK(서버)에서만 쓰기 가능
      // 관리자도 콘솔/서버에서 처리하므로 클라이언트 쓰기 불필요
      allow write: if false;
    }

    // ── 결제 내역 ──
    // 사용자는 본인 결제 내역만 읽기 가능, 쓰기는 서버(Admin SDK)에서만
    match /paymentHistory/{paymentId} {
      allow read: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
      allow read: if isAdmin();

      // 클라이언트 쓰기 차단 — Admin SDK(서버)에서만 쓰기 가능
      allow write: if false;
    }

    // ── 서명 요청 (전자계약) ──
    match /signing_requests/{requestId} {
      // 변호사: 본인 사건 서명 요청 생성/조회
      allow create: if isOwnerOnCreate();
      allow read, update: if isOwner();
      // 의뢰인: 토큰으로 서명 요청 조회/서명 완료 (인증 불필요)
      allow read, update: if true;
      allow read: if isAdmin();
    }

    // ── CODEF 연결 계정 ──
    match /codef_accounts/{accountId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();
      allow read: if isAdmin();
    }

    // ── 은행 거래내역 ──
    match /bank_transactions/{txId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();
      allow read: if isAdmin();
    }

    // ── 카드 거래내역 ──
    match /card_transactions/{txId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();
      allow read: if isAdmin();
    }

    // ── AI 매칭 대기 ──
    match /pending_matches/{matchId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();
      allow read: if isAdmin();
    }

    // ── 홈택스 세금계산서 ──
    match /tax_invoices/{invoiceId} {
      allow create: if isOwnerOnCreate();
      allow read, update, delete: if isOwner();
      allow read: if isAdmin();
    }

    // ── 버그 리포트 (베타 테스트) ──
    match /bug_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
    }
  }
}
