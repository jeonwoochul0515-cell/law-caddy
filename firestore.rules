rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ──

    // 로그인 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 관리자 역할 확인
    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // 본인 문서 확인 (ownerId 필드 기준)
    function isOwner() {
      return isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
    }

    // 생성 시 본인 ownerId 필드 확인
    function isOwnerOnCreate() {
      return isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
    }

    // 수정 시 본인 문서이고 ownerId를 바꾸지 않는지 확인.
    // ownerId를 다른 값으로 바꾸면 그 문서는 본인도 못 읽는 고아가 되거나 남에게 넘어간다.
    function isOwnerUpdate() {
      return isOwner()
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    // 수정 요청에서 특정 필드가 바뀌지 않았는지 확인.
    // get(key, null)을 쓰는 이유: 기존 문서에 그 필드가 없을 때 resource.data.field를
    // 직접 참조하면 규칙이 오류로 평가돼 수정이 통째로 막힌다.
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ── 사용자 프로필 ──
    match /users/{uid} {
      // 본인 문서 읽기
      allow read: if isAuthenticated() && request.auth.uid == uid;

      // 본인 문서 생성 (가입 시).
      // status는 "pending"만 허용한다. 예전에는 "approved"도 허용해서, OCR 키워드만 맞으면
      // 클라이언트가 스스로 승인 상태로 가입할 수 있었다(승인 문턱 무력화). 승인은 관리자만 한다.
      // plan은 "free" 고정, 만료일·검증·승인 필드는 가입 시 넣을 수 없다.
      allow create: if isAuthenticated() && request.auth.uid == uid
        && request.resource.data.role == "lawyer"
        && request.resource.data.status == "pending"
        && request.resource.data.get("plan", "free") == "free"
        && request.resource.data.get("planExpiresAt", null) == null
        && request.resource.data.get("verified", null) == null
        && request.resource.data.get("approvedAt", null) == null
        && request.resource.data.get("approvedBy", null) == null;

      // 본인 문서 수정.
      //
      // - role, plan, planExpiresAt, expiryNotifiedAt, signupNotifiedAt은 클라이언트가 절대 바꿀 수 없다.
      //   결제 승인(/api/payment/confirm)·만료 문자(/api/notify/expiry)·가입 알림(/api/notify/signup)은
      //   서비스 계정 REST로 쓰므로 규칙을 우회한다. 이 줄이 없으면 브라우저 콘솔에서 plan:"pro"를 써서
      //   결제를 우회하거나, 알림 기록을 지워 관리자 문자를 반복해서 보낼 수 있다.
      // - verified·approvedAt·approvedBy(관리자 확인 흔적)도 본인이 못 바꾼다.
      // - status는 원칙적으로 그대로여야 한다. pending→approved 자기 승인은 금지(관리자만).
      //   예외 하나: 거절(rejected)된 회원이 서류를 다시 내면 rejected→pending으로 돌아갈 수 있다.
      //   이때만 거절 사유(rejectedReason·rejectedAt·rejectedBy)를 비울 수 있다.
      allow update: if isAuthenticated() && request.auth.uid == uid
        && unchanged("role")
        && unchanged("plan")
        && unchanged("planExpiresAt")
        && unchanged("expiryNotifiedAt")
        && unchanged("signupNotifiedAt")
        && unchanged("verified")
        && unchanged("verifiedAt")
        && unchanged("verifiedBy")
        && unchanged("approvedAt")
        && unchanged("approvedBy")
        && (
          (
            request.resource.data.status == resource.data.status
            && unchanged("rejectedReason")
            && unchanged("rejectedAt")
            && unchanged("rejectedBy")
          )
          || (
            resource.data.status == "rejected"
            && request.resource.data.status == "pending"
            && request.resource.data.profileCompleted == true
          )
        );

      // 관리자: 모든 사용자 문서 읽기/수정.
      // 승인(pending→approved)·거절·되돌리기·검증·요금제 수동 부여(plan·planExpiresAt)가 여기로 온다.
      // planExpiresAt은 timestamp만 받는다 — 콘솔에서 문자열로 넣으면 서버 판정이 "만료 없음"이
      // 되어 영구 유료가 되는 실수를 규칙에서 막는다.
      // 삭제는 열지 않는다. 관리자 「탈퇴」는 status:"rejected"로 표시만 하고, 실제 삭제는 콘솔·서버에서.
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.role in ["lawyer", "admin"]
        && request.resource.data.status in ["pending", "approved", "rejected"]
        && request.resource.data.get("plan", "free") in ["free", "starter", "pro", "team"]
        && (request.resource.data.get("planExpiresAt", null) == null
            || request.resource.data.planExpiresAt is timestamp);
    }

    // ── 사건 ──
    match /cases/{caseId} {
      // 생성 시 ownerId 검증 + status 유효값 검증 (src/types/case.ts와 같은 값)
      allow create: if isOwnerOnCreate()
        && request.resource.data.status in ["진행중", "완료", "보류"];

      // 본인 문서 읽기
      allow read: if isOwner();

      // 수정 시 status 유효값 검증 (타임라인·portalToken·clientPhone 갱신도 여기로 온다)
      allow update: if isOwnerUpdate()
        && request.resource.data.status in ["진행중", "완료", "보류"];

      // 삭제는 본인만
      allow delete: if isOwner();

      // 관리자: 읽기 허용
      allow read: if isAdmin();

      // ── 의뢰인 케어 메시지 (서브컬렉션) ──
      match /clientCareMessages/{messageId} {
        // 사건 소유자만 읽기/쓰기
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;

        // 관리자: 읽기 허용
        allow read: if isAdmin();
      }
    }

    // ── 녹음 ──
    match /recordings/{recordingId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner();
      allow update: if isOwnerUpdate();

      // 관리자: 읽기 허용
      allow read: if isAdmin();
    }

    // ── 법률 문서 ──
    match /documents/{documentId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner();
      allow update: if isOwnerUpdate();

      // 관리자: 읽기 허용
      allow read: if isAdmin();
    }

    // ── 상대방 서면 ──
    match /opponentDocs/{docId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner();
      allow update: if isOwnerUpdate();

      // 관리자: 읽기 허용
      allow read: if isAdmin();
    }

    // ── 사건기록 (전자소송 PDF + 자동 분류 + AI 분석 결과 임베드) ──
    match /case_records/{recordId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner();
      allow update: if isOwnerUpdate();

      // 관리자: 읽기 허용
      allow read: if isAdmin();
    }

    // ── 사건 기한 (일정 탭) ──
    match /deadlines/{deadlineId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner();
      allow update: if isOwnerUpdate();

      // 관리자: 읽기 허용
      allow read: if isAdmin();
    }

    // ── 수임료 (Fees) ──
    match /fees/{feeId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner();
      allow update: if isOwnerUpdate();
      allow read: if isAdmin();

      // ── 분할납부 (Installments 서브컬렉션) ──
      match /installments/{installmentId} {
        allow create: if isAuthenticated()
          && get(/databases/$(database)/documents/fees/$(feeId)).data.ownerId == request.auth.uid;
        allow read, update, delete: if isAuthenticated()
          && get(/databases/$(database)/documents/fees/$(feeId)).data.ownerId == request.auth.uid;
        allow read: if isAdmin();
      }
    }

    // ── 사건별 경비 (Case Expenses) ──
    match /case_expenses/{expenseId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner();
      allow update: if isOwnerUpdate();
      allow read: if isAdmin();
    }

    // ── 거래 내역 (Transactions) ──
    match /transactions/{transactionId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner();
      allow update: if isOwnerUpdate();
      allow read: if isAdmin();
    }

    // ── 사무소 경비 (Office Expenses) ──
    match /office_expenses/{expenseId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner();
      allow update: if isOwnerUpdate();
      allow read: if isAdmin();
    }

    // ── 예수금 (Deposits) ──
    match /deposits/{depositId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner();
      allow update: if isOwnerUpdate();
      allow read: if isAdmin();
    }

    // ── 월별 요약 (Monthly Summary) — 문서 ID = {ownerId}_{YYYY-MM} ──
    // services/firebase/accounting.ts와 services/reportGenerator.ts가 읽고 쓴다.
    // 이 규칙이 없어 세무/월별 리포트 기능이 전부 permission-denied 상태였다.
    match /monthly_summary/{summaryId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner();
      allow update: if isOwnerUpdate();
      allow read: if isAdmin();
    }

    // ── 월별 사용량 (Usage Monthly) — 문서 ID = {uid}_{YYYY-MM} ──
    // 서버(/api/claude·/api/transcribe 등)가 서비스 계정으로 호출 횟수를 기록한다.
    // 클라이언트는 본인 것만 읽는다. 쓰기를 열면 카운터를 0으로 되돌려 무료 한도를 우회할 수 있다.
    match /usage_monthly/{usageId} {
      allow read: if isAuthenticated()
        && (resource.data.get("uid", null) == request.auth.uid
            || resource.data.get("ownerId", null) == request.auth.uid);
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── 구독 정보 ──
    // (미사용 — 단건 결제 전환 전 잔재. 2026-09-11 기준 화면·서버 어디서도 읽고 쓰지 않는다.
    //  삭제해도 되지만 예전 데이터가 남아 있을 수 있어 읽기만 열어 둔다.)
    match /subscriptions/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── 결제 내역 ──
    // (미사용 — 단건 결제 전환 전 잔재. 현재 결제 기록은 아래 payments에 쌓인다.)
    match /paymentHistory/{paymentId} {
      allow read: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── 결제 기록 (Toss 단건 결제 — 서버 REST가 기록, 문서 ID = orderId) ──
    match /payments/{orderId} {
      allow read: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
      allow read: if isAdmin();

      // 클라이언트 쓰기 차단 — 서버(서비스 계정 REST)에서만 기록
      allow write: if false;
    }

    // ── 서명 요청 (전자계약) ──
    //
    // 의뢰인(미인증)의 조회·서명은 /api/signing/{token} 서버 엔드포인트가 처리한다.
    // 서비스 계정으로 접근하므로 이 규칙의 영향을 받지 않는다.
    //
    // 이전에는 여기에 `allow read, update: if true`가 있었다. 주석은 "토큰으로 조회"였지만
    // 규칙에는 토큰 검증이 없어서, 인증 없이 컬렉션 전체를 읽고 수정할 수 있었다.
    // (수임계약서 전문 유출 + 제3자가 남의 계약을 서명 완료 처리 가능)
    //
    // status 값은 src/types/signing.ts와 같다(pending·signed·expired). "signed"는 서버만 쓴다 —
    // 변호사가 화면에서 서명 완료로 바꿔 놓으면 의뢰인 서명 없이 계약이 체결된 것처럼 보인다.
    match /signing_requests/{requestId} {
      allow create: if isOwnerOnCreate()
        && request.resource.data.status == "pending";
      allow read, delete: if isOwner();
      allow update: if isOwnerUpdate()
        && (request.resource.data.status == resource.data.status
            || request.resource.data.status == "expired");
      allow read: if isAdmin();
    }

    // ── 버그 리포트 (베타 테스트) ──
    // 제보자는 본인 uid로만 만들고(status "open"), 읽기·상태 변경은 관리자만.
    match /bug_reports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == "open";
      allow read: if isAdmin();
      // 관리자: 처리 상태(open/resolved) 변경 — src/types/bugReport.ts와 같은 값
      allow update: if isAdmin()
        && request.resource.data.status in ["open", "resolved"];
    }
  }
}
